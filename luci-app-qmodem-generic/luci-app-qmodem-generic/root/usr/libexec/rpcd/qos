#!/bin/sh
# QModem QOS/Radio ubus service — QCI / AMBR（签约速率）/ APN / 调制信息查询
# 部署路径: /usr/libexec/rpcd/qos （必须可执行，rpcd 才会加载）
#
# ⚠️ 本插件在异步化改造后**只读缓存**，不再自己发 AT 指令。
#
# 改造前的问题（LuCI 白屏的主要来源之一）
# --------------------------------------
# 旧实现直接在 rpcd 里执行 AT：
#     qos_info   : AT+CGEQOSRDP → AT+C5GQOSRDP → AT+CGCONTRDP，每条 -t 8
#     radio_info : AT+GTCAINFO? → AT+QNWCFG="nr5g_csi"，每条 -t 8
# 模组不支持时要把每条命令都等到超时，最坏 3×8s + 2×8s = 40 秒；
# 而 LuCI 的 rpc.js 会把同一 tick 内的多个 rpc.declare 合并成一个 HTTP 批量请求，
# rpcd 顺序执行 —— 这 40 秒会拖住同批次的**所有**请求（包括别的页面的），
# 20 秒后整批一起超时，概览页直接白屏。
# 同时 tom_modem 直连串口，与 QModem 自身的 AT 访问互相抢占，响应可能串台。
#
# 改造后
# ------
#   AT 探测搬到 /usr/lib/qmodem/qmodem-at-probe，只由 qmodem-worker（后台）
#   在持有 AT 互斥锁时执行，结果写入 /tmp/qmodem-cache/<section>/qos.json
#   与 radio.json。本插件只 cat 缓存文件，毫秒级返回；缓存缺失时立即返回
#   status=unavailable 并顺手排一个后台刷新任务，绝不阻塞调用方。
#
# 返回结构与旧版完全一致（向后兼容）：
#   qos_info   : { "qci":N, "downlink_rate_kbps":N?, "uplink_rate_kbps":N?,
#                  "apn":"..."?, "status":"ok|no_data|unavailable" }
#   radio_info : { "rat":"LTE|NR", "band":"...", "dl_modulation":"...",
#                  "ul_modulation":"...", "dl_mimo":N, "ul_mimo":N,
#                  "status":"ok|unavailable" }
# 新增：
#   refresh    : { "config_section":"..." } → 排一个后台 AT 探测任务，
#                立即返回 task_id（不等待）

. "${QMODEM_LIB_DIR:-/usr/lib/qmodem}/qmodem-lib.sh"

TASK_BIN=/usr/bin/qmodem-task
DEFAULT_TTL="${QMODEM_STALE_AFTER:-90}"

j_str() {
	printf '"%s"' "$(printf '%s' "$1" | qm_json_escape)"
}

# 从缓存信封里取出 data 字段原文（纯字符串裁剪，不解析 JSON）
cache_data() {
	_body=$(qm_read_domain "$1" "$2" 2>/dev/null) || return 1
	[ -n "$_body" ] || return 1
	case "$_body" in
		*'"data":'*) ;;
		*) return 1 ;;
	esac
	# 取最后一个 "data": 之后的内容，去掉收尾的 }
	printf '%s' "${_body##*\"data\":}" | sed 's/}$//'
}

emit_unavailable() {
	case "$1" in
		qos_info) printf '{"qci":null,"five_qi":null,"downlink_rate_kbps":null,"uplink_rate_kbps":null,"status":"unavailable","stale":true}\n' ;;
		*)        printf '{"status":"unavailable","stale":true}\n' ;;
	esac
}

# 缓存缺失/过期时排一个后台任务（fire-and-forget，不等待结果）
queue_refresh() {
	[ -n "$1" ] || return 0
	[ -f "$TASK_BIN" ] || return 0
	sh "$TASK_BIN" new refresh "$1" '{"domains":"qos radio"}' >/dev/null 2>&1 &
	return 0
}

case "$1" in
	list)
		echo '{"qos_info":{"config_section":"string"},"radio_info":{"config_section":"string"},"refresh":{"config_section":"string"}}'
	;;
	call)
		INPUT=''
		read -r INPUT
		[ -n "$INPUT" ] || INPUT='{}'
		qm_init_dirs

		config_section=$(printf '%s' "$INPUT" | jsonfilter -e '@.config_section' 2>/dev/null)
		case "$config_section" in
			''|*[!A-Za-z0-9_-]*) config_section='' ;;
		esac

		case "$2" in
			refresh)
				if [ -z "$config_section" ]; then
					printf '{"success":false,"error":"invalid config_section"}\n'
				elif [ -f "$TASK_BIN" ]; then
					sh "$TASK_BIN" new refresh "$config_section" '{"domains":"qos radio"}' 2>/dev/null \
						|| printf '{"success":false,"error":"failed to create task"}\n'
				else
					printf '{"success":false,"error":"qmodem-task missing"}\n'
				fi
				;;

			qos_info|radio_info)
				if [ -z "$config_section" ]; then
					emit_unavailable "$2"
					exit 0
				fi

				case "$2" in
					qos_info)   _dom=qos ;;
					radio_info) _dom=radio ;;
				esac

				_body=$(qm_read_domain "$config_section" "$_dom" 2>/dev/null)
				if [ -z "$_body" ]; then
					# 缓存还没建立：立即返回不可用 + 后台补采，绝不现场打 AT
					queue_refresh "$config_section"
					emit_unavailable "$2"
					exit 0
				fi

				_status=$(printf '%s' "$_body" | jsonfilter -e '@.status' 2>/dev/null)
				_updated=$(printf '%s' "$_body" | jsonfilter -e '@.updated' 2>/dev/null)
				case "$_updated" in ''|*[!0-9]*) _updated=0 ;; esac
				_age=$(( $(qm_now) - _updated ))

				# 过期缓存：仍然先把旧数据返回（页面不至于变空），同时后台补采
				if [ "$_age" -gt "$DEFAULT_TTL" ]; then
					queue_refresh "$config_section"
				fi

				_data=$(cache_data "$config_section" "$_dom")
				if [ -z "$_data" ]; then
					emit_unavailable "$2"
					exit 0
				fi

				# 附加 age/stale/cache_status，方便前端显示「数据可能过期」
				printf '%s' "$_data" | sed "s/}$/,\"cache_status\":\"${_status:-unknown}\",\"age\":${_age},\"stale\":$([ "$_age" -gt "$DEFAULT_TTL" ] && echo true || echo false)}/"
				printf '\n'
				;;

			*)
				printf '{"status":"unavailable","error":"unknown method"}\n'
				;;
		esac
	;;
esac
