#!/bin/sh
# 用户自定义型号及串口拓扑。只读取 sysfs/UCI；串口探测仅在用户主动点击时执行。
. "${QMODEM_LIB_DIR:-/usr/lib/qmodem}/qmodem-lib.sh"

CUSTOM_DIR="${QMODEM_CUSTOM_SUPPORT_DIR:-/etc/qmodem-generic/modems}"
SYS_TTY="${QMODEM_SYS_TTY_DIR:-/sys/class/tty}"
SYS_WWAN="${QMODEM_SYS_WWAN_DIR:-/sys/class/wwan}"
DEV_DIR="${QMODEM_DEV_DIR:-/dev}"

quote() { printf '%s' "$1" | qm_json_escape; }
error() { printf '{"success":false,"error":"%s"}\n' "$(quote "$1")"; }
valid_model() {
	case "$1" in ''|*[!a-z0-9-]*|-*|*-) return 1 ;; esac
	[ "${#1}" -le 48 ]
}
valid_hex4() {
	case "$1" in [0-9a-f][0-9a-f][0-9a-f][0-9a-f]) return 0 ;; esac
	return 1
}


# 将插件自定义 JSON 原子同步到官方 QModem 支持库。只允许更新原自定义定义匹配的条目。
SUPPORT="$QMODEM_SUPPORT_FILE"
[ -n "$SUPPORT" ] || SUPPORT=/usr/share/qmodem/modem_support.json
EXTRA="$QMODEM_EXTRA_SUPPORT_FILE"
[ -n "$EXTRA" ] || EXTRA=/usr/share/qmodem-generic/extra_modem_support.json
LOCKDIR="$QMODEM_SUPPORT_LOCKDIR"
[ -n "$LOCKDIR" ] || LOCKDIR=/var/run/qmodem-modem-support.lock

has_entry() {
	jq -e --arg bus "$2" --arg model "$3" '.modem_support[$bus] | type == "object" and has($model)' "$1" >/dev/null 2>&1
}
matches_source() {
	jq -ne --arg bus "$3" --arg model "$4" --slurpfile official "$1" --slurpfile source "$2" \
		'$official[0].modem_support[$bus][$model] == $source[0].modem_support[$bus][$model]' >/dev/null 2>&1
}
apply_custom() {
	[ -f "$SUPPORT" ] && jq -e '.modem_support.usb and .modem_support.pcie' "$SUPPORT" >/dev/null 2>&1 ||
		{ rm -f "$_tmp"; error 'QModem 支持库不存在或 JSON 格式错误'; return; }
	mkdir -p "$(dirname "$LOCKDIR")" 2>/dev/null || { rm -f "$_tmp"; error '无法创建锁目录'; return; }
	mkdir "$LOCKDIR" 2>/dev/null || { rm -f "$_tmp"; error '支持库同步正在进行，请稍后重试'; return; }
	# 不触碰其它配置项，编辑期间拒绝并发同步；正常/失败均释放锁
	_original=''
	[ -f "$_dest" ] && _original="$_dest"
	if [ -z "$_original" ] && [ -f "$EXTRA" ] && has_entry "$EXTRA" "$_bus" "$_model"; then _original="$EXTRA"; fi
	if [ "$_edit" = 1 ] && [ -z "$_original" ]; then
		error '只能编辑自定义库中已收录的型号，不能修改 QModem 官方原生型号'
		rm -f "$_tmp"; rmdir "$LOCKDIR"; return
	fi
	if [ "$_edit" != 1 ] && [ -n "$_original" ]; then
		error '自定义库已存在该型号，请选择编辑'
		rm -f "$_tmp"; rmdir "$LOCKDIR"; return
	fi
	if has_entry "$SUPPORT" "$_bus" "$_model"; then
		if [ -z "$_original" ] || ! matches_source "$SUPPORT" "$_original" "$_bus" "$_model"; then
			error '官方支持库条目与自定义源不同，禁止覆盖，请先检查冲突'
			rm -f "$_tmp"; rmdir "$LOCKDIR"; return
		fi
	fi
	_target_tmp="$SUPPORT.custom.$$"
	if ! jq --arg bus "$_bus" --arg model "$_model" --slurpfile data "$_tmp" \
		'.modem_support[$bus][$model] = $data[0].modem_support[$bus][$model]' "$SUPPORT" > "$_target_tmp" 2>/dev/null ||
		! jq -e --arg bus "$_bus" --arg model "$_model" \
		'.modem_support[$bus][$model].modes | type == "array"' "$_target_tmp" >/dev/null 2>&1; then
		rm -f "$_tmp" "$_target_tmp"; rmdir "$LOCKDIR"
		error '生成支持库失败，原始文件未更改'; return
	fi
	# 备份是更新的前置条件；原来 QModem 的其它型号都由 jq 原样保留
	if ! cp -p "$SUPPORT" "$SUPPORT.bak" 2>/dev/null; then
		rm -f "$_tmp" "$_target_tmp"; rmdir "$LOCKDIR"
		error '无法备份 QModem 支持库，已取消'; return
	fi
	if [ -f "$_dest" ] && ! cp -p "$_dest" "$_dest.bak" 2>/dev/null; then
		rm -f "$_tmp" "$_target_tmp"; rmdir "$LOCKDIR"
		error '无法备份自定义 JSON，已取消'; return
	fi
	if ! cat "$_target_tmp" > "$SUPPORT" 2>/dev/null ||
		! jq -e '.modem_support.usb and .modem_support.pcie' "$SUPPORT" >/dev/null 2>&1; then
		cp -p "$SUPPORT.bak" "$SUPPORT" 2>/dev/null || true
		rm -f "$_tmp" "$_target_tmp"; rmdir "$LOCKDIR"
		error '更新 QModem 支持库失败，已尝试回滚备份'; return
	fi
	if ! mv -f "$_tmp" "$_dest" 2>/dev/null; then
		cp -p "$SUPPORT.bak" "$SUPPORT" 2>/dev/null || true
		rm -f "$_tmp" "$_target_tmp"; rmdir "$LOCKDIR"
		error '保存自定义 JSON 失败，已尝试恢复 QModem 备份'; return
	fi
	rm -f "$_target_tmp"; rmdir "$LOCKDIR"
	printf '{"success":true,"bus":"%s","model":"%s","updated":%s,"synced":true}\n' "$_bus" "$_model" "$_edit"
}

# 文件名与子目录只来自上述白名单；每个文件就是一个 QModem 支持库条目。
save_model() {
	_input=$(cat)
	_bus=$(printf '%s' "$_input" | jsonfilter -e '@.bus' 2>/dev/null)
	_model=$(printf '%s' "$_input" | jsonfilter -e '@.model' 2>/dev/null | tr 'A-Z' 'a-z')
	_vendor=$(printf '%s' "$_input" | jsonfilter -e '@.manufacturer' 2>/dev/null | tr 'A-Z' 'a-z')
	_platform=$(printf '%s' "$_input" | jsonfilter -e '@.platform' 2>/dev/null | tr 'A-Z' 'a-z')
	_vid=$(printf '%s' "$_input" | jsonfilter -e '@.manufacturer_id' 2>/dev/null | tr 'A-F' 'a-f')
	_modes=$(printf '%s' "$_input" | jsonfilter -e '@.modes' 2>/dev/null)
	_pdp=$(printf '%s' "$_input" | jsonfilter -e '@.pdp_index' 2>/dev/null)
	_edit=$(printf '%s' "$_input" | jsonfilter -e '@.edit' 2>/dev/null)
	[ "$_edit" = 1 ] || _edit=0
	_wcdma=$(printf '%s' "$_input" | jsonfilter -e '@.wcdma_band' 2>/dev/null)
	_lte=$(printf '%s' "$_input" | jsonfilter -e '@.lte_band' 2>/dev/null)
	_nsa=$(printf '%s' "$_input" | jsonfilter -e '@.nsa_band' 2>/dev/null)
	_sa=$(printf '%s' "$_input" | jsonfilter -e '@.sa_band' 2>/dev/null)
	case "$_bus" in usb|pcie) ;; *) error '连接方式只能选择 USB 或 PCIe'; return ;; esac
	valid_model "$_model" || { error '型号只允许小写字母、数字和中划线（最多 48 位）'; return; }
	case "$_vendor" in ''|*[!a-z0-9_-]*) error '厂商标识只能使用英文字母、数字和中划线'; return ;; esac
	[ "${#_vendor}" -le 32 ] || { error '厂商标识过长'; return; }
	case "$_platform" in qualcomm|mediatek|unisoc|lte|lte12|hisilicon|asrmicro) ;; *) error '平台类型不受支持'; return ;; esac
	if [ "$_bus" = usb ]; then
		valid_hex4 "$_vid" || { error 'USB 厂商 ID 必须为 4 位十六进制数'; return; }
	fi
	case "$_pdp" in ''|*[!0-9]*) error 'PDP 序号应为 1 至 16'; return ;; esac
	[ "$_pdp" -ge 1 ] && [ "$_pdp" -le 16 ] || { error 'PDP 序号应为 1 至 16'; return; }
	# QModem 频段采用 1/3/5 格式；空值代表未知（0），不冒充全部支持。
	for _band_name in wcdma lte nsa sa; do
		case "$_band_name" in
			wcdma) _raw="$_wcdma" ;;
			lte) _raw="$_lte" ;;
			nsa) _raw="$_nsa" ;;
			sa) _raw="$_sa" ;;
		esac
		_clean=$(printf '%s' "$_raw" | tr ',; ' '///' | sed 's#//*#/#g;s#^/##;s#/$##')
		[ -n "$_clean" ] || _clean=0
		[ "${#_clean}" -le 255 ] && printf '%s' "$_clean" | grep -Eq '^[0-9]+(/[0-9]+)*$' || {
			error "$_band_name 频段只允许数字，以 /、逗号或空格分隔"; return;
		}
		case "$_band_name" in
			wcdma) _wcdma="$_clean" ;;
			lte) _lte="$_clean" ;;
			nsa) _nsa="$_clean" ;;
			sa) _sa="$_clean" ;;
		esac
	done
	case "$_modes" in ''|*[!a-z,]*) error '拨号协议格式无效'; return ;; esac
	[ "${#_modes}" -le 64 ] || { error '拨号协议列表过长'; return; }
	case "$_modes" in ,*|*,|*,,*) error '拨号协议列表不能包含空项'; return ;; esac
	_modes_json=''; _seen=','
	_old_ifs="$IFS"; IFS=,
	for _mode in $_modes; do
		case "$_mode" in qmi|gobinet|mbim|rmnet) ;;
			ecm|rndis|ncm|auto) [ "$_bus" = usb ] || { IFS="$_old_ifs"; error 'PCIe 不接受该 USB 拨号协议'; return; } ;;
			*) IFS="$_old_ifs"; error '包含未支持的拨号协议'; return ;;
		esac
		case "$_seen" in *",$_mode,"*) continue ;; esac
		_seen="$_seen$_mode,"
		[ -z "$_modes_json" ] || _modes_json="$_modes_json, "
		_modes_json="$_modes_json\"$_mode\""
	done
	IFS="$_old_ifs"
	[ -n "$_modes_json" ] || { error '请至少选择一种拨号协议'; return; }
	_dest="$CUSTOM_DIR/$_bus/$_model.json"
	( umask 022; mkdir -p "$CUSTOM_DIR/$_bus" ) || { error '无法创建自定义配置目录'; return; }
	_tmp="$_dest.tmp.$$"
	{
		printf '{\n    "modem_support": {\n        "%s": {\n            "%s": {\n' "$_bus" "$_model"
		[ "$_bus" = usb ] && printf '                "manufacturer_id": "%s",\n' "$_vid"
		printf '                "manufacturer": "%s",\n                "platform": "%s",\n                "data_interface": "%s",\n' "$_vendor" "$_platform" "$_bus"
		printf '                "pdp_index": "%s",\n                "wcdma_band": "%s",\n                "lte_band": "%s",\n' "$_pdp" "$_wcdma" "$_lte"
		printf '                "nsa_band": "%s",\n                "sa_band": "%s",\n                "modes": [%s]\n            }\n        }\n    }\n}\n' "$_nsa" "$_sa" "$_modes_json"
	} > "$_tmp" || { rm -f "$_tmp"; error '写入配置失败'; return; }
	jsonfilter -i "$_tmp" -e '@.modem_support' >/dev/null 2>&1 || { rm -f "$_tmp"; error '生成的配置无法解析'; return; }
	apply_custom
}

delete_model() {
	_input=$(cat)
	_bus=$(printf '%s' "$_input" | jsonfilter -e '@.bus' 2>/dev/null)
	_model=$(printf '%s' "$_input" | jsonfilter -e '@.model' 2>/dev/null)
	case "$_bus" in usb|pcie) ;; *) error '连接方式无效'; return ;; esac
	valid_model "$_model" || { error '型号无效'; return; }
	_dest="$CUSTOM_DIR/$_bus/$_model.json"
	[ -f "$_dest" ] || { error '未找到这条自定义配置'; return; }
	rm -f "$_dest" || { error '删除失败'; return; }
	printf '{"success":true}\n'
}

list_models() {
	_first=1
	printf '{"entries":['
	for _f in "$CUSTOM_DIR"/usb/*.json "$CUSTOM_DIR"/pcie/*.json; do
		[ -f "$_f" ] || continue
		_bus=$(basename "$(dirname "$_f")")
		_model=$(basename "$_f" .json)
		valid_model "$_model" || continue
		_vid=$(sed -n 's/.*"manufacturer_id": "\([0-9a-f]*\)".*/\1/p' "$_f" | head -n 1)
		_modes=$(sed -n 's/.*"modes": \[\(.*\)\].*/\1/p' "$_f" | tr -d '" ')
		[ "$_first" = 1 ] || printf ','
		_first=0
		printf '{"bus":"%s","model":"%s","manufacturer_id":"%s","modes":"%s"}' "$_bus" "$_model" "$_vid" "$_modes"
	done
	printf '],"presets":'
	# 读取已安装的 QModem 支持库作为动态模板，不覆盖原有配置。
	_lib="${QMODEM_SUPPORT_FILE:-/usr/share/qmodem/modem_support.json}"
	if [ -r "$_lib" ] && [ "$(wc -c < "$_lib" 2>/dev/null)" -le 524288 ] &&
		jsonfilter -i "$_lib" -e '@.modem_support' >/dev/null 2>&1; then
		_template=''
		if command -v jq >/dev/null 2>&1; then
			_template=$(jq -c '{usb:(.modem_support.usb // {}),pcie:(.modem_support.pcie // {})}' "$_lib" 2>/dev/null)
		fi
		case "$_template" in
			\{*) printf '%s' "$_template" ;;
			*) cat "$_lib" ;;
		esac
	else
		printf '{}'
	fi
	printf '}\n'
}

# 返回 tty 的物理设备：先找 USB 父节点，再找 PCIe BDF；不会把 USB 控制器误当成模组。
device_info() {
	_sys=$(readlink -f "$1/device" 2>/dev/null)
	[ -n "$_sys" ] || return 1
	_cur="$_sys"
	while [ "$_cur" != / ] && [ -n "$_cur" ]; do
		if [ -r "$_cur/idVendor" ] && [ -r "$_cur/idProduct" ]; then
			_bus=usb
			_id="$(cat "$_cur/idVendor"):$(cat "$_cur/idProduct")"
			_location=$(basename "$_cur")
			_product=$(cat "$_cur/product" 2>/dev/null)
			return 0
		fi
		_cur="${_cur%/*}"
	done
	_cur="$_sys"
	while [ "$_cur" != / ] && [ -n "$_cur" ]; do
		case "$(basename "$_cur")" in
			????:??:??.?)
				if [ -r "$_cur/vendor" ] && [ -r "$_cur/device" ]; then
					_bus=pcie
					_id="$(cat "$_cur/vendor" | sed 's/^0x//'):$(cat "$_cur/device" | sed 's/^0x//')"
					_location=$(basename "$_cur")
					_product=''
					return 0
				fi ;;
		esac
		_cur="${_cur%/*}"
	done
	return 1
}

port_sections() {
	uci -q show qmodem 2>/dev/null | sed -n "s/^qmodem\.\([A-Za-z0-9_-]*\)='\{0,1\}modem-device'\{0,1\}$/\1/p"
}

ports() {
	_sections=$(port_sections)
	_first=1
	printf '{"ports":['
	for _entry in "$SYS_TTY"/ttyUSB[0-9]* "$SYS_TTY"/ttyACM[0-9]* "$SYS_TTY"/mhi_* "$SYS_WWAN"/*at*; do
		[ -e "$_entry/device" ] || continue
		_port="$DEV_DIR/$(basename "$_entry")"
		[ -c "$_port" ] || continue
		device_info "$_entry" || continue
		_port_bus="$_bus"; _port_id="$_id"; _port_location="$_location"; _port_product="$_product"
		_model=''; _confirmed=0; _section=''
		for _s in $_sections; do
			_at=$(uci -q get "qmodem.$_s.at_port" 2>/dev/null)
			_override=$(uci -q get "qmodem.$_s.override_at_port" 2>/dev/null)
			_valid=$(uci -q get "qmodem.$_s.valid_at_ports" 2>/dev/null)
			if [ "$_port" = "$_at" ] || [ "$_port" = "$_override" ]; then
				_confirmed=1; _section="$_s"
			else
				case " $_valid " in *" $_port "*) _confirmed=1; _section="$_s" ;; esac
			fi
			# 其它串口可继承同一物理设备已识别的型号，但仍标记为候选口。
			if [ -z "$_section" ] && [ -n "$_at" ]; then
				_peer="$SYS_TTY/$(basename "$_at")"
				[ -e "$_peer/device" ] || _peer="$SYS_WWAN/$(basename "$_at")"
				if [ -e "$_peer/device" ] && device_info "$_peer" &&
					[ "$_bus" = "$_port_bus" ] && [ "$_location" = "$_port_location" ]; then
					_section="$_s"
				fi
			fi
			[ -n "$_section" ] || continue
			_model=$(uci -q get "qmodem.$_s.model" 2>/dev/null)
			[ -n "$_model" ] || _model=$(uci -q get "qmodem.$_s.name" 2>/dev/null)
			break
		done
		[ -n "$_model" ] || _model="$_port_product"
		[ "$_first" = 1 ] || printf ','
		_first=0
		printf '{"port":"%s","bus":"%s","id":"%s","location":"%s","model":"%s","section":"%s","confirmed":%s}' \
			"$(quote "$_port")" "$_port_bus" "$(quote "$_port_id")" "$(quote "$_port_location")" \
			"$(quote "$_model")" "$(quote "$_section")" "$_confirmed"
	done
	printf ']}\n'
}

probe() {
	_input=$(cat)
	_port=$(printf '%s' "$_input" | jsonfilter -e '@.port' 2>/dev/null)
	case "$_port" in "$DEV_DIR"/ttyUSB[0-9]*|"$DEV_DIR"/ttyACM[0-9]*|"$DEV_DIR"/mhi_*|"$DEV_DIR"/wwan*at*) ;; *) error '串口路径无效'; return ;; esac
	_name=$(basename "$_port")
	_entry="$SYS_TTY/$_name"
	[ -e "$_entry/device" ] || _entry="$SYS_WWAN/$_name"
	[ -e "$_entry/device" ] && [ -c "$_port" ] && device_info "$_entry" || { error '串口不属于可识别的 USB/PCIe 设备'; return; }
	for _s in $(port_sections); do
		_at=$(uci -q get "qmodem.$_s.at_port" 2>/dev/null)
		_override=$(uci -q get "qmodem.$_s.override_at_port" 2>/dev/null)
		_valid=$(uci -q get "qmodem.$_s.valid_at_ports" 2>/dev/null)
		{ [ "$_port" = "$_at" ] || [ "$_port" = "$_override" ]; } && { error '该串口已由 QModem 管理，请使用 AT 控制台'; return; }
		case " $_valid " in *" $_port "*) error '该串口已由 QModem 管理，请使用 AT 控制台'; return ;; esac
	done
	command -v tom_modem >/dev/null 2>&1 || { error '未找到 tom_modem，无法读取型号'; return; }
	_lock="at.$(printf '%s' "$_port" | tr '/.' '__')"
	qm_lock "$_lock" 0 || { error '该串口正忙，请稍后再试'; return; }
	trap 'qm_unlock_all' EXIT INT TERM
	_out=$(timeout 5 tom_modem -d "$_port" -o a -c 'AT+CGMM' -t 2 2>/dev/null | tr -d '\r')
	qm_unlock "$_lock"
	trap - EXIT INT TERM
	_model=$(printf '%s\n' "$_out" | sed '/^[[:space:]]*$/d;/^[Aa][Tt]+[Cc][Gg][Mm][Mm]$/d;/^[Oo][Kk]$/d;/^[Ee][Rr][Rr][Oo][Rr]$/d;s/^+CGMM:[[:space:]]*//' | head -n 1 | cut -c 1-96)
	case "$_model" in ''|*ERROR*|*error*) error '串口未返回模组型号，可能不是 AT 口'; return ;; esac
	printf '{"success":true,"model":"%s"}\n' "$(quote "$_model")"
}

case "$1" in
	save) save_model ;;
	delete) delete_model ;;
	list) list_models ;;
	ports) ports ;;
	probe) probe ;;
	*) error '未知操作' ;;
esac
