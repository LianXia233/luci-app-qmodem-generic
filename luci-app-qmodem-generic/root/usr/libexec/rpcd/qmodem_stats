#!/bin/sh
# QModem 流量统计 rpcd 服务 — 暴露持久化的分天流量记录给 LuCI。
# 存储：/etc/qmodem-stats/<section>.stats，重启保留；日期按中国时区（UTC+8）切分。
#
# 采样架构（自包含，只依赖 QModem 官方 `qmodem get_stats` 接口）：
#   /etc/init.d/qmodem-stats-collect + qmodem-stats-loop   每 60 秒后台采样落盘，
#                                                          页面未打开时也持续累计。
#   本插件只读 .stats 文件（纯文件 IO，毫秒级，绝不访问 modem）；
#   数据偏旧时在后台拉一次采样进程补齐，立即返回现有值。
#   唯一例外是 stats_reset：清零需要读一次模组计数器建立新基准，
#   由用户显式点击触发，同步执行但带硬超时（采集器内部 8 秒 ubus 超时）。
#
# 方法：
#   daily_stats   读取统计（只读文件，必要时后台补采）
#   stats_history 仅读取已存储的统计（不触发采样）
#   stats_reset   清零本地分天记录并重建基准（同步，带硬超时）

COLLECT_BIN="/usr/bin/qmodem-stats-collect"
STALE_AFTER="${QMODEM_STATS_STALE:-150}"
RESET_TIMEOUT="${QMODEM_STATS_RESET_TIMEOUT:-15}"

j_str() {
	_v=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g' | tr -d '\000-\011\013-\037')
	printf '"%s"' "$_v"
}

qm_now() {
	date +%s
}

qm_init_dirs() {
	mkdir -p /etc/qmodem-stats 2>/dev/null || true
}

# 数据偏旧时在后台补采一次（fire-and-forget，不影响本 RPC 返回）
queue_collect() {
	[ -f "$COLLECT_BIN" ] || return 0
	( sh "$COLLECT_BIN" run "$1" >/dev/null 2>&1 & ) 2>/dev/null
	return 0
}

case "$1" in
	list)
		echo '{"daily_stats":{"config_section":"string"},"stats_history":{"config_section":"string"},"stats_reset":{"config_section":"string"}}'
		;;
	call)
		read -r input
		config_section=$(echo "$input" | jsonfilter -e '@.config_section' 2>/dev/null)
		case "$config_section" in
			''|*[!a-zA-Z0-9_-]*) config_section='' ;;
		esac
		if [ -z "$config_section" ]; then
			echo '{"error":"invalid config_section"}'
			exit 0
		fi

		qm_init_dirs

		case "$2" in
			daily_stats)
				# 只读 .stats 文件（show 不采样、不碰 modem）；偏旧时后台补采
				if [ -f "$COLLECT_BIN" ]; then
					_out=$(sh "$COLLECT_BIN" show "$config_section" 2>/dev/null)
					case "$_out" in
						\{*)
							_updated=$(printf '%s' "$_out" | jsonfilter -e '@.updated_at' 2>/dev/null)
							case "$_updated" in ''|*[!0-9]*) _updated=0 ;; esac
							[ $(( $(qm_now) - _updated )) -gt "$STALE_AFTER" ] && queue_collect "$config_section"
							printf '%s\n' "$_out"
							exit 0
							;;
					esac
				fi

				# 什么都没有：立即返回空统计 + 后台补采
				queue_collect "$config_section"
				printf '{"config_section":%s,"updated_at":0,"available":0,"today_rx":0,"today_tx":0,"total_rx":0,"total_tx":0,"swapped":0,"days":[],"stale":true}\n' \
					"$(j_str "$config_section")"
				;;

			stats_history)
				# 语义不变：只读已存储的统计，从不采样
				if [ -f "$COLLECT_BIN" ]; then
					sh "$COLLECT_BIN" show "$config_section"
				else
					printf '{"config_section":%s,"available":0,"days":[]}\n' "$(j_str "$config_section")"
				fi
				;;

			stats_reset)
				# 清零需要读一次模组计数器作为新基准；用户显式触发，同步执行，
				# 采集器内部对 ubus 有 8 秒硬超时，这里再兜一层 timeout。
				if [ -f "$COLLECT_BIN" ]; then
					_out=$(timeout "$RESET_TIMEOUT" sh "$COLLECT_BIN" reset "$config_section" 2>/dev/null)
					case "$_out" in
						\{*) printf '%s\n' "$_out" ;;
						*)   printf '{"config_section":%s,"result":0,"success":false,"error":"stats reset timed out"}\n' "$(j_str "$config_section")" ;;
					esac
				else
					printf '{"config_section":%s,"result":0,"success":false,"error":"stats collector missing"}\n' "$(j_str "$config_section")"
				fi
				;;

			*) echo '{"error":"unknown method"}' ;;
		esac
		;;
esac
