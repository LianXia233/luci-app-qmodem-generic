#!/bin/sh
# QModem QOS ubus service — 提供 QCI / AMBR 查询
# 供 luci-app-qmodem-generic 前端通过 rpc.declare 调用
# 部署路径: /usr/libexec/rpcd/qos

. /usr/share/libubox/jshn.sh

TOOL="/usr/bin/tom_modem"

case "$1" in
  list)
    echo '{"qos_info":{}}'
    ;;
  call)
    case "$2" in
      qos_info)
        read input
        json_load "$input"
        json_get_var config_section config_section
        case "$config_section" in
          ''|*[!a-zA-Z0-9_-]*) config_section='' ;;
        esac
        TTY_DEV=$(uci -q get "qmodem.${config_section}.override_at_port")
        [ -z "$TTY_DEV" ] && TTY_DEV=$(uci -q get "qmodem.${config_section}.at_port")
        json_init
        if [ -x "$TOOL" ] && [ -c "$TTY_DEV" ]; then
          RAW=$("$TOOL" -d "$TTY_DEV" -c "AT+CGEQOSRDP=1" -t 8 2>&1)
          # 解析 +CGEQOSRDP: <cid>,<QCI>,...,<DL_AMBR>,<UL_AMBR> 格式
          QOS_LINE=$(printf '%s\n' "$RAW" | sed -n 's/.*+CGEQOSRDP:[[:space:]]*//p' | head -n1)
          QCI=''
          DL_AMBR=''
          UL_AMBR=''
          if [ -n "$QOS_LINE" ]; then
            QCI=$(printf '%s\n' "$QOS_LINE" | awk -F',' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $2); print $2}')
            DL_AMBR=$(printf '%s\n' "$QOS_LINE" | awk -F',' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $(NF-1)); print $(NF-1)}')
            UL_AMBR=$(printf '%s\n' "$QOS_LINE" | awk -F',' '{gsub(/^[[:space:]]+|[[:space:]]+$/, "", $NF); print $NF}')
          fi
          if [ -n "$QCI" ] || [ -n "$DL_AMBR" ] || [ -n "$UL_AMBR" ]; then
            [ -n "$QCI" ] && json_add_int "qci" "$QCI"
            [ -n "$DL_AMBR" ] && json_add_int "downlink_rate_kbps" "$DL_AMBR"
            [ -n "$UL_AMBR" ] && json_add_int "uplink_rate_kbps" "$UL_AMBR"
            json_add_string "status" "ok"
          else
            json_add_int "qci" 0
            json_add_string "status" "no_data"
          fi
        else
          json_add_int "qci" 0
          json_add_string "status" "unavailable"
        fi
        json_dump
        ;;
    esac
    ;;
esac
