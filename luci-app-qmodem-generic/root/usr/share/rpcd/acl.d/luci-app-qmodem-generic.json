{
	"luci-app-qmodem-generic": {
		"description": "Grant access to QModem generic modem management UI",
		"read": {
			"uci": [ "qmodem", "network" ],
			"ubus": {
				"qmodem": [ "*" ],
				"qmodem.sms": [ "status", "config_get", "sync_status", "list", "get", "modem_list", "storage_get" ],
				"qmodem.uplink": [ "status" ],
				"qmodem_stats": [ "*" ],
				"qmodem_support": [ "*" ],
				"rc": [ "list" ],
				"network.device": [ "status" ],
				"network.interface": [ "status", "dump" ]
			}
		},
		"write": {
			"uci": [ "qmodem" ],
			"ubus": {
				"uci": [ "commit" ],
				"qmodem": [ "*" ],
				"qmodem.sms": [ "configure", "sync", "send", "delete", "mark_read", "modem_delete", "storage_set" ],
				"qmodem_stats": [ "*" ],
				"qmodem_support": [ "*" ],
				"rc": [ "list" ],
				"luci": [ "setInitAction" ]
			}
		}
	}
}
