{
	"luci-app-qmodem-generic": {
		"description": "Grant access to QModem generic modem management UI",
		"read": {
			"uci": [ "qmodem" ],
			"ubus": {
				"qmodem": [ "*" ],
				"qmodem.sms": [ "config_get", "list" ],
				"qmodem_cache": [ "*" ],
				"qmodem_stats": [ "*" ],
				"qmodem_support": [ "*" ],
				"qos": [ "*" ],
				"rc": [ "list" ],
				"luci": [ "setInitAction" ],
				"network.device": [ "status" ],
				"network.interface": [ "status", "dump" ]
			}
		},
		"write": {
			"uci": [ "qmodem" ],
			"ubus": {
				"uci": [ "commit" ],
				"qmodem": [ "*" ],
				"qmodem.sms": [ "send", "delete", "mark_read", "sync" ],
				"qmodem_cache": [ "*" ],
				"qmodem_stats": [ "*" ],
				"qmodem_support": [ "*" ],
				"qos": [ "*" ],
				"rc": [ "list" ],
				"luci": [ "setInitAction" ]
			}
		}
	}
}
