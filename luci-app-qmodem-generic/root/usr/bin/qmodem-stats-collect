#!/bin/sh
# QModem 流量统计持久化采集器 — 分天记录、重启不丢失、按中国时区（UTC+8）切日。
#
# 数据来源（全模组通用，按序回退）：
#   1) ubus qmodem get_stats —— QModem 官方口径（vendor 脚本可能上报模组内部
#      计数或 netdev 计数），available=1 时直接采用；
#   2) netdev 兜底 —— 从 /etc/config/qmodem <节>.network 指定的网口读取
#      /sys/class/net/<dev>/statistics/{rx,tx}_bytes 内核计数器。
#
# 存储：/etc/qmodem-stats/<section>.stats（overlay 持久分区，重启保留）。
#
# 用法：
#   qmodem-stats-collect run  <config_section>   采样一次并落盘，输出当前统计 JSON
#   qmodem-stats-collect show <config_section>   仅输出当前统计 JSON（不采样）
#   qmodem-stats-collect reset <config_section>  清零本地累计与分天记录（配合
#                                                QModem 定时清零/手动清零使用）
#
# 阻塞约定（异步化改造后）：
#   * `show`  纯文件读取，**绝不**访问 modem —— rpcd 的只读方法只允许调它；
#   * `run`   会读一次模组计数器，只允许由后台服务/后台任务调用，
#             且该读取带 STATS_UBUS_TIMEOUT 硬超时；
#   * `reset` 同 `run`，需要读计数器建立新基准，因此由后台任务执行。
#
# 方向自动识别：正常模组 rx(下行) 远大于 tx(上行)。个别驱动把两个计数器接反，
# 累计流量超过 50MB 且 tx > rx 时判定方向颠倒，输出中自动交换并以 swapped=1 标记。

STATS_DIR="${QMODEM_STATS_DIR:-/etc/qmodem-stats}"
KEEP_DAYS=90
SWAP_MIN_BYTES=$((50 * 1024 * 1024))

# 单次 modem 查询的硬超时（秒）。采样会调用 ubus qmodem get_stats，
# 那是一次真正的 modem/AT 查询 —— 绝不允许无限等待，否则后台循环会被拖死。
STATS_UBUS_TIMEOUT="${QMODEM_STATS_UBUS_TIMEOUT:-8}"

# 带硬超时的 ubus 封装（本组件自包含，不依赖任何插件私有库）：
# timeout 命令保证 modem 失联时采样调用也会按时失败，绝不无限等待。
qm_stats_ubus() {
	timeout "$STATS_UBUS_TIMEOUT" ubus call "$1" "$2" "$3" 2>/dev/null
}

# jshn（json_* 函数）：OpenWrt 固件自带；缺失时回退到内置的纯 shell JSON 生成器
if [ -f /usr/share/libubox/jshn.sh ]; then
	. /usr/share/libubox/jshn.sh
else
	# 内置 JSON 生成器：_J 为已生成的 JSON 片段，_JS 为容器栈（o=对象 a=数组），
	# _NEED=1 表示下一个字段/元素前需要补逗号。
	json_init() { _J=''; _JS=''; _NEED=0; }
	__esc() { printf '%s' "$1" | awk '{gsub(/\\/, "\\\\"); gsub(/"/, "\\\""); printf "%s", $0}'; }
	__sep() { [ "$_NEED" = 1 ] && _J="$_J,"; _NEED=0; }
	json_add_string() { __sep; _J="$_J\"$1\":\"$(__esc "$2")\""; _NEED=1; }
	json_add_int() { case "$2" in ''|*[!0-9-]*) v=0 ;; *) v=$2 ;; esac; __sep; _J="$_J\"$1\":$v"; _NEED=1; }
	json_add_boolean() { [ "$2" = "1" ] && v=true || v=false; __sep; _J="$_J\"$1\":$v"; _NEED=1; }
	json_add_array() { __sep; _J="$_J\"$1\":["; _JS="$_JS a"; }
	json_close_array() { _J="$_J]"; _JS=${_JS%?}; _NEED=1; }
	json_add_object() { __sep; _J="$_J{ "; _JS="$_JS o"; }
	json_close_object() { _J="$_J }"; _JS=${_JS%?}; _NEED=1; }
	json_dump() { printf '{%s}\n' "$_J"; }
fi

# ---- 工具函数 -------------------------------------------------------------

# epoch 秒 → 中国时区（UTC+8）的「日序号」，即该日距 1970-01-01 的天数
cn_day_index() {
	awk -v t="$1" 'BEGIN{
		i = t + 28800
		if (i >= 0) print int(i / 86400)
		else print int((i - 86399) / 86400)
	}'
}

# epoch 秒 → 中国时区日期 YYYY-MM-DD。
# 只用整数运算，不调用 awk 的 strftime/mktime：busybox awk 没有 mktime，
# mawk 两个都没有；一旦静默失败，跨日归属和保留期裁剪就会算错。
# 日期换算用 civil_from_days 算法，已对照参考实现全量校验。
cn_day_of() {
	awk -v t="$1" '
		BEGIN {
			i = t + 28800
			if (i >= 0) z = int(i / 86400); else z = int((i - 86399) / 86400)
			z += 719468
			era = int((z >= 0 ? z : z - 146096) / 146097)
			doe = z - era * 146097
			yoe = int((doe - int(doe / 1460) + int(doe / 36524) - int(doe / 146096)) / 365)
			y = yoe + era * 400
			doy = doe - (365 * yoe + int(yoe / 4) - int(yoe / 100))
			mp = int((5 * doy + 2) / 153)
			d = doy - int((153 * mp + 2) / 5) + 1
			m = mp + (mp < 10 ? 3 : -9)
			y = y + (m <= 2 ? 1 : 0)
			printf "%04d-%02d-%02d\n", y, m, d
		}'
}

cn_span_days() {
	# 两个时刻之间相差的中国日期天数（同日为 0）
	awk -v a="$1" -v b="$2" 'BEGIN{
		sa = a + 28800; sb = b + 28800
		if (sa >= 0) ia = int(sa / 86400); else ia = int((sa - 86399) / 86400)
		if (sb >= 0) ib = int(sb / 86400); else ib = int((sb - 86399) / 86400)
		print ib - ia
	}'
}


# 日期键（2026-08-26）→ 合法 shell 变量名前缀（连字符替换为下划线）
day_var() {
	printf 'd_%s' "$(printf '%s' "$1" | tr '-' '_')"
}

is_num() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

load_stats() {
	last_ts=0; last_rx=0; last_tx=0; total_rx=0; total_tx=0; swapped=0; day=""
	# 文件不存在（首次采样）时保留上述默认值，保证后续算术运算可用
	[ -f "$1" ] || return 0
	while IFS='=' read -r k v; do
		case "$k" in
			last_ts) is_num "$v" && last_ts=$v ;;
			last_rx) is_num "$v" && last_rx=$v ;;
			last_tx) is_num "$v" && last_tx=$v ;;
			total_rx) is_num "$v" && total_rx=$v ;;
			total_tx) is_num "$v" && total_tx=$v ;;
			swapped) swapped=$v ;;
			day_*)
				d=${k#day_}
				case "$d" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) continue ;; esac
				is_num "$v" || continue
				case " $day " in *" $d "*) ;; *) day="$day $d" ;; esac
				eval "$(day_var "$d")_rx=\$v"
				;;
			dayx_*)
				d=${k#dayx_}
				case "$d" in [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]) ;; *) continue ;; esac
				is_num "$v" || continue
				case " $day " in *" $d "*) ;; *) day="$day $d" ;; esac
				eval "$(day_var "$d")_tx=\$v"
				;;
		esac
	done < "$1"
}

save_stats() {
	now="$2"
	tmp="${1}.tmp.$$"
	tmp2="${1}.tmp2.$$"
	{
		echo "last_ts=$now"
		echo "last_rx=$last_rx"
		echo "last_tx=$last_tx"
		echo "total_rx=$total_rx"
		echo "total_tx=$total_tx"
		echo "swapped=$swapped"
		for d in $day; do
			vp="$(day_var "$d")"
			eval "v=\"\${${vp}_rx}\""; is_num "$v" && echo "day_${d}=$v"
			eval "v=\"\${${vp}_tx}\""; is_num "$v" && echo "dayx_${d}=$v"
		done
	} > "$tmp"
	cutoff=$(cn_day_of "$((now - KEEP_DAYS * 86400))")
	{
		grep -Ev '^day' "$tmp"
		while IFS='=' read -r key val; do
			case "$key" in
				day_*)
					d=${key#day_}
					[ ! "$d" \< "$cutoff" ] && echo "${key}=${val}"
					;;
				dayx_*)
					d=${key#dayx_}
					[ ! "$d" \< "$cutoff" ] && echo "${key}=${val}"
					;;
			esac
		done < "$tmp"
	} > "$tmp2"
	mv "$tmp2" "$1"
	rm -f "$tmp"
}

add_delta() {
	_d="$1"; _dr="$2"; _dt="$3"
	is_num "$_dr" || _dr=0
	is_num "$_dt" || _dt=0
	[ "$_dr" -eq 0 ] && [ "$_dt" -eq 0 ] && return 0

	vp="$(day_var "$_d")"
	eval "rx=\"\${${vp}_rx:-0}\""
	eval "tx=\"\${${vp}_tx:-0}\""
	rx=$((rx + _dr)); tx=$((tx + _dt))
	eval "${vp}_rx=$rx"; eval "${vp}_tx=$tx"
	case " $day " in *" $_d "*) ;; *) day="$day $_d" ;; esac
	total_rx=$((total_rx + _dr))
	total_tx=$((total_tx + _dt))
}

# ---- 互斥锁 ---------------------------------------------------------------
# 「读计数器 → 算增量 → 落盘」必须整体互斥：后台 60 秒循环和 rpcd 在数据
# 偏旧时拉起的补采进程会同时跑 run，两边都按同一份基准算增量、再各自写回，
# 结果是流量被记两次、且 ${FILE}.tmp 互相覆盖。这里用 mkdir 原子性做锁，
# pid + 时间戳写在锁内，便于回收崩溃残留的锁。

LOCK_DIR="${QMODEM_STATS_LOCKDIR:-/var/lock/qmodem-stats.lock}"
LOCK_RETRY="${QMODEM_STATS_LOCK_RETRY:-10}"
LOCK_STALE="${QMODEM_STATS_LOCK_STALE:-120}"
HELD_LOCK=0

lock_owner_dead() {
	# 锁里没有可信 pid、pid 已不存在，或持锁超过 LOCK_STALE 秒 → 视为残留
	_p=''; _t=''
	[ -f "$LOCK_DIR/pid" ] && read -r _p _t < "$LOCK_DIR/pid" 2>/dev/null
	case "$_p" in
		''|*[!0-9]*) return 0 ;;
	esac
	kill -0 "$_p" 2>/dev/null || return 0
	case "$_t" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ $(( $(date +%s) - _t )) -gt "$LOCK_STALE" ]
}

acquire_lock() {
	local _try=0
	mkdir -p "$(dirname "$LOCK_DIR")" 2>/dev/null || true
	while [ "$_try" -lt "$LOCK_RETRY" ]; do
		if mkdir "$LOCK_DIR" 2>/dev/null; then
			printf '%s %s\n' "$$" "$(date +%s)" > "$LOCK_DIR/pid" 2>/dev/null || true
			HELD_LOCK=1
			trap 'release_lock' EXIT INT TERM
			return 0
		fi
		if lock_owner_dead; then
			rm -f "$LOCK_DIR/pid" 2>/dev/null || true
			rmdir "$LOCK_DIR" 2>/dev/null || true
			_try=$((_try + 1))
			continue
		fi
		_try=$((_try + 1))
		sleep 1
	done
	return 1
}

release_lock() {
	[ "$HELD_LOCK" = 1 ] || return 0
	HELD_LOCK=0
	rm -f "$LOCK_DIR/pid" 2>/dev/null || true
	rmdir "$LOCK_DIR" 2>/dev/null || true
}

# ---- 当前计数器读取 -------------------------------------------------------

read_counters() {
	config_section="$1"
	cur_rx=''; cur_tx=''

	# 带硬超时的 modem 查询：modem 失联时最多等 STATS_UBUS_TIMEOUT 秒即返回空，
	# 由下面的 netdev 兜底路径继续工作
	resp=$(qm_stats_ubus qmodem get_stats "{\"config_section\":\"$config_section\"}")
	if [ -n "$resp" ]; then
		if [ "$(jsonfilter -s "$resp" -e '@.available' 2>/dev/null)" = "true" ]; then
			cur_rx=$(jsonfilter -s "$resp" -e '@.total_rx_bytes' 2>/dev/null)
			cur_tx=$(jsonfilter -s "$resp" -e '@.total_tx_bytes' 2>/dev/null)
		fi
	fi

	is_num "$cur_rx" || cur_rx=''
	is_num "$cur_tx" || cur_tx=''

	# 兜底：直接读内核 netdev 计数器（QModem 未实现 get_stats 的模组也通用）
	if [ -z "$cur_rx" ] && [ -z "$cur_tx" ]; then
		netdev=$(uci -q get "qmodem.${config_section}.network" 2>/dev/null)
		if [ -n "$netdev" ] && [ -r "/sys/class/net/${netdev}/statistics/rx_bytes" ]; then
			cur_rx=$(cat "/sys/class/net/${netdev}/statistics/rx_bytes" 2>/dev/null)
			cur_tx=$(cat "/sys/class/net/${netdev}/statistics/tx_bytes" 2>/dev/null)
			is_num "$cur_rx" || cur_rx=''
			is_num "$cur_tx" || cur_tx=''
		fi
	fi

	[ -n "$cur_rx" ] || [ -n "$cur_tx" ]
}

# ---- 主逻辑 ---------------------------------------------------------------

do_run() {
	config_section="$1"
	mkdir -p "$STATS_DIR"
	FILE="$STATS_DIR/${config_section}.stats"

	# 取不到锁说明已有采集进程在写同一份文件：本次只输出当前值，绝不重复计数
	if ! acquire_lock; then
		do_show "$config_section"
		return 0
	fi

	# 必须在锁内 load：等锁期间另一个进程可能已经推进了基准
	load_stats "$FILE"
	now=$(date +%s)

	# 首次运行（无状态文件）时 load_stats 未执行，这里统一补齐默认值，
	# 保证后续算术比较不会遇到空变量。
	last_ts=${last_ts:-0}; last_rx=${last_rx:-0}; last_tx=${last_tx:-0}
	total_rx=${total_rx:-0}; total_tx=${total_tx:-0}; swapped=${swapped:-0}

	if read_counters "$config_section"; then
		# 只有一侧计数器可读时另一侧会是空串，先补齐，避免 $((cur - base)) 出错
		is_num "$cur_rx" || cur_rx=0
		is_num "$cur_tx" || cur_tx=0
		today=$(cn_day_of "$now")

		if [ "$last_ts" -gt 0 ]; then
			last_day=$(cn_day_of "$last_ts")
			# 计数器回绕/重置（模组重拨、驱动重置）时，新值小于旧值 →
			# 增量从 0 起算，新计数值即为本轮新增流量。
			dr=$((cur_rx - last_rx)); [ "$dr" -lt 0 ] && dr=$cur_rx
			dt=$((cur_tx - last_tx)); [ "$dt" -lt 0 ] && dt=$cur_tx

			if [ "$today" = "$last_day" ]; then
				add_delta "$today" "$dr" "$dt"
			else
				# 跨日界：采样间隔内的流量无法精确归属，按跨越的天数均分，
				# 余数记在今天，保证各天之和恰好等于本次增量。
				n=$(cn_span_days "$last_ts" "$now")
				[ "$n" -ge 1 ] || n=1
				_pr=$((dr / n))
				_pt=$((dt / n))
				_i=1
				while [ "$_i" -lt "$n" ]; do
					add_delta "$(cn_day_of $((now - _i * 86400)))" "$_pr" "$_pt"
					_i=$((_i + 1))
				done
				add_delta "$today" $((dr - _pr * (n - 1))) $((dt - _pt * (n - 1)))
			fi
		else
			: # 首次采样：只记基准点，不计增量
		fi

		last_ts=$now
		last_rx=$cur_rx
		last_tx=$cur_tx

		# 方向自动识别：累计流量足够大且 tx > rx，视为该驱动上下行相反
		if [ "$total_rx" -gt "$SWAP_MIN_BYTES" ] && [ "$total_tx" -gt "$total_rx" ]; then
			swapped=1
		fi

		save_stats "$FILE" "$now"
	fi

	release_lock
	do_show "$config_section"
}

do_show() {
	config_section="$1"
	FILE="$STATS_DIR/${config_section}.stats"
	[ -f "$FILE" ] && load_stats "$FILE"
	now=$(date +%s)
	today=$(cn_day_of "$now")

	json_init
	json_add_string config_section "$config_section"
	json_add_int updated_at "$last_ts"
	json_add_boolean available 1
	vp="$(day_var "$today")"
	eval "t_rx=\"\${${vp}_rx:-0}\""
	eval "t_tx=\"\${${vp}_tx:-0}\""
	is_num "$total_rx" || total_rx=0
	is_num "$total_tx" || total_tx=0
	case "$swapped" in 1) ;; *) swapped=0 ;; esac
	json_add_int today_rx "$t_rx"
	json_add_int today_tx "$t_tx"
	json_add_int total_rx "$total_rx"
	json_add_int total_tx "$total_tx"
	json_add_int swapped "$swapped"

	json_add_array days
	for d in $day; do
		[ "$d" \< "$today" ] || continue
		vp="$(day_var "$d")"
		json_add_object
		json_add_string date "$d"
		eval "json_add_int rx \"\${${vp}_rx:-0}\""
		eval "json_add_int tx \"\${${vp}_tx:-0}\""
		json_close_object
	done
	json_close_array

	json_dump
}

do_reset() {
	config_section="$1"
	FILE="$STATS_DIR/${config_section}.stats"
	mkdir -p "$STATS_DIR"

	if ! acquire_lock; then
		json_init
		json_add_string config_section "$config_section"
		json_add_boolean result 0
		json_add_boolean success false
		json_add_string error "another stats collection is running, try again later"
		json_dump
		return 1
	fi

	# 默认沿用文件里的基准：读不到模组计数器时（modem 失联、AT 口忙、超时），
	# 绝不能把基准写成 0 —— 否则下一次采样会把模组自开机以来的全部累计流量
	# 当成「本次新增」记进今天，图表上表现为一个巨大的尖峰。
	base_rx=0
	base_tx=0
	load_stats "$FILE"
	base_rx=$last_rx
	base_tx=$last_tx
	if read_counters "$config_section"; then
		is_num "$cur_rx" || cur_rx=$base_rx
		is_num "$cur_tx" || cur_tx=$base_tx
		base_rx=$cur_rx
		base_tx=$cur_tx
	fi

	now=$(date +%s)
	{
		echo "last_ts=$now"
		echo "last_rx=$base_rx"
		echo "last_tx=$base_tx"
		echo "total_rx=0"
		echo "total_tx=0"
		echo "swapped=0"
	} > "$FILE.tmp.$$"
	mv "$FILE.tmp.$$" "$FILE"
	release_lock

	json_init
	json_add_string config_section "$config_section"
	json_add_boolean result 1
	json_dump
}

case "$1" in
	run)   shift; do_run "$@" ;;
	show)  shift; do_show "$@" ;;
	reset) shift; do_reset "$@" ;;
	*) echo "Usage: $0 {run|show|reset} <config_section>" >&2; exit 1 ;;
esac
