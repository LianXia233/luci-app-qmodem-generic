#!/bin/sh
# qmodem-at-probe — QoS / 射频调制信息的 AT 探测（后台执行，绝不在 rpcd 里跑）
#
# 用法：
#   qmodem-at-probe qos_info   <config_section>   → 输出单行 JSON
#   qmodem-at-probe radio_info <config_section>   → 输出单行 JSON
#
# 为什么从 /usr/libexec/rpcd/qos 里搬出来
# --------------------------------------
# 这段逻辑要按序尝试最多 3 条（qos_info）/ 2 条（radio_info）AT 命令，
# 每条都可能等到超时。放在 rpcd 插件里意味着：
#   LuCI 一次 RPC → rpcd 同步执行 AT → 最长 3×8s = 24 秒不返回
# 而 LuCI 的 rpc.js 会把同一 tick 内的多个 rpc.declare 调用**合并成一个
# HTTP 批量请求**，rpcd 顺序执行 —— 一个慢方法会拖住整批（含其它页面的请求），
# 20 秒后整批一起超时，页面直接白屏。
# 现在探测只在 qmodem-worker（后台）里执行，结果写入状态缓存，
# /usr/libexec/rpcd/qos 只读缓存，毫秒级返回。
#
# AT 通道约定：调用方（qmodem-worker / qmodem-task）必须已持有
# `qm_at_lock_name <section>` 互斥锁，本脚本自身不加锁、也不并发访问串口。
#
# 探测策略与旧版完全一致（保持行为兼容）：
#   qos_info   : AT+CGEQOSRDP=<cid> → AT+C5GQOSRDP → AT+CGCONTRDP
#   radio_info : AT+GTCAINFO? → AT+QNWCFG="nr5g_csi"
# 区别仅在于：AT 优先经 QModem 的 send_at 下发（由 QModem 统一调度串口），
# 仅在 QModem 未实现 send_at 时才回退到 tom_modem 直连。

. "${QMODEM_LIB_DIR:-/usr/lib/qmodem}/qmodem-lib.sh"

TOOL="/usr/bin/tom_modem"

# ---- AT 下发（带硬超时） --------------------------------------------------

# 从 send_at 的 JSON 返回里挑出响应正文
probe_pick_text() {
	_r="$1"
	for _k in result response at_response output data stdout message ret; do
		_v=$(jsonfilter -s "$_r" -e "@.$_k" 2>/dev/null)
		if [ -n "$_v" ]; then
			printf '%s' "$_v" | tr -d '\r'
			return 0
		fi
	done
	# 裸字符串返回（"OK\r\n..."）
	_v=$(jsonfilter -s "$_r" -e '@' 2>/dev/null)
	if [ -n "$_v" ]; then
		printf '%s' "$_v" | tr -d '\r'
		return 0
	fi
	return 1
}

# probe_at <section> <at-command> → 响应文本（失败输出空）
probe_at() {
	_sec="$1"; _cmd="$2"
	_esc=$(printf '%s' "$_cmd" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')

	# 1) 首选：经 QModem 下发，由 QModem 统一管理串口，天然串行
	_r=$(qm_ubus qmodem send_at \
		"{\"config_section\":\"$_sec\",\"params\":{\"at\":\"$_esc\"}}" \
		"$QMODEM_AT_TIMEOUT" 2>/dev/null)
	if [ -n "$_r" ]; then
		_t=$(probe_pick_text "$_r")
		[ -n "$_t" ] && { printf '%s' "$_t"; return 0; }
	fi

	# 2) 回退：tom_modem 直连（QModem 未实现 send_at 的旧版本）
	if [ -x "$TOOL" ]; then
		_dev=$(qm_at_port "$_sec")
		if [ -n "$_dev" ] && [ -c "$_dev" ]; then
			"$TOOL" -d "$_dev" -c "$_cmd" -t "$QMODEM_AT_TIMEOUT" 2>&1 | tr -d '\r'
			return 0
		fi
	fi
	return 1
}

is_num() {
	case "$1" in
		''|*[!0-9]*) return 1 ;;
		*) return 0 ;;
	esac
}

# 调制枚举 → 文案（3GPP TS 36/38 常见表述；GTCAINFO 定义 0-6）
mod_name() {
	case "$1" in
		0) echo "BPSK" ;;
		1) echo "QPSK" ;;
		2) echo "16QAM" ;;
		3) echo "64QAM" ;;
		4) echo "256QAM" ;;
		5) echo "1024QAM" ;;
		*) echo "" ;;
	esac
}

emit_unavailable_qos() {
	printf '{"status":"unavailable","qci":null,"qci_source":null,"five_qi":null,"five_qi_source":null,"downlink_rate_kbps":null,"uplink_rate_kbps":null,"rate_source":null,"apn":null,"cid":null}\n'
}
emit_unavailable_radio() {
	printf '{"status":"unavailable"}\n'
}

# ---- QoS 解析辅助 ---------------------------------------------------------
#
# 数据链路：AT↓ → 原始响应 → 独立解析器 → 标准 JSON。
# 发送（probe_at）与解析完全分离；QCI 与 5QI（QoS Level）绝不混用，
# 单位统一为 kbps，未知一律 null（不是 0），并带 source 字段便于排查。

# 从 "a|b|c" 里取第 n 个字段（| 分隔）
field_of() {
	printf '%s' "$2" | awk -v n="$1" 'BEGIN{FS="|"}{print $n}'
}

# 把 AMBR 归一化到 kbps。
#  CGEQOSRDP / C5GQOSRDP 的 AMBR 按 3GPP 规范为 kbps，直接采用；
#  CGCONTRDP 的 AMBR 部分模组给 kbps、部分给 bps，这里用“超过 1e6 视为 bps → /1000”
#  的启发式处理，并在 rate_source 保留命令名以便核对。超出 10 Gbps 的极端值视为脏值。
norm_kbps() {
	_v="$1"; _cmd="$2"
	is_num "$_v" || { printf ''; return 1; }
	[ "$_v" -gt 0 ] || { printf ''; return 1; }
	if [ "$_cmd" = "CGCONTRDP" ] && [ "$_v" -ge 1000000 ]; then
		printf '%s' $(( _v / 1000 ))
	elif [ "$_v" -le 10000000 ]; then
		printf '%s' "$_v"
	else
		printf ''
	fi
}

# 收集 active PDP Context（cid|apn|dl_ambr|ul_ambr）。只暴露已建立会话的上下文，
# 天然过滤掉 IMS / CBS 等非用户数据承载，并按配置 APN 精确匹配。来源 CGCONTRDP。
cgcontr_contexts() {
	_sec="$1"
	_lines=$(probe_at "$_sec" 'AT+CGCONTRDP' 2>/dev/null | grep '^+CGCONTRDP:' | sed -n 's/^+CGCONTRDP:[[:space:]]*//p')
	[ -n "$_lines" ] || return 0
	printf '%s\n' "$_lines" | while IFS= read -r _l; do
		[ -n "$_l" ] || continue
		_cid=$(printf '%s\n' "$_l" | awk -F',' '{gsub(/[^0-9]/,"",$1); print $1}')
		[ -n "$_cid" ] || continue
		_apn=$(printf '%s\n' "$_l" | awk -F',' '{gsub(/"/,"",$3); gsub(/^[ \t]+|[ \t]+$/,"",$3); print $3}')
		_dl=$(printf '%s\n' "$_l" | awk -F',' '{print $(NF-1)}')
		_ul=$(printf '%s\n' "$_l" | awk -F',' '{print $NF}')
		printf '%s|%s|%s|%s\n' "$_cid" "$_apn" "$_dl" "$_ul"
	done
}

# 选出“当前拨号数据上下文”的 cid：优先精确匹配配置 APN，其次非 ims/cbs/wap/mms/dun
# 的默认数据承载，最后回退第一个 active context。绝不写死 CID=1、绝不错把 IMS 当数据 APN。
pick_context_cid() {
	_cfg="$1"; shift
	_fb=''
	for _c in "$@"; do
		_cid=$(field_of 1 "$_c"); _apn=$(field_of 2 "$_c")
		[ -n "$_cid" ] && [ -z "$_fb" ] && _fb="$_cid"
		if [ -n "$_cfg" ] && [ -n "$_apn" ] && [ "$_apn" = "$_cfg" ]; then
			printf '%s' "$_cid"; return 0
		fi
		case "$_apn" in
			ims|cbs|wap|mms|dun|IMS|CBS|"") ;;
			*) printf '%s' "$_cid"; return 0 ;;
		esac
	done
	printf '%s' "$_fb"
}

# JSON key/value 累积器（全局 QKV）
QKV=''
qkv() {
	if [ -n "$QKV" ]; then QKV="$QKV,"; fi
	QKV="$QKV\"$1\":$2"
}
json_num() { is_num "$1" && printf '%s' "$1" || printf 'null'; }
json_str() { [ -n "$1" ] && printf '"%s"' "$(printf '%s' "$1" | qm_json_escape)" || printf 'null'; }

# ---- qos_info -------------------------------------------------------------
#
# 统一输出：
#   { "status":"ok|partial|no_data|unavailable",
#     "qci":9,"qci_source":"AT+CGEQOSRDP",
#     "five_qi":9,"five_qi_source":"AT+C5GQOSRDP",
#     "downlink_rate_kbps":102400,"uplink_rate_kbps":51200,"rate_source":"AT+CGEQOSRDP",
#     "apn":"cmnet","cid":1 }
# QCI（LTE）与 5QI（5G）分开采集、互不覆盖；来源都带 source 标记。

do_qos_info() {
	SEC="$1"
	[ -n "$(qm_at_port "$SEC")" ] || { emit_unavailable_qos; return 0; }

	CFG_APN=$(uci -q get "qmodem.$SEC.apn" 2>/dev/null)
	QKV=''
	QCI=''; QCI_SRC=''; FIVE_QI=''; FIVE_QI_SRC=''
	DL_KBPS=''; UL_KBPS=''; RATE_SRC=''; APN=''; CID=''
	DOMAIN=''     # LTE | NR | 空（QoS Level 归属的制式提示，仅诊断用）

	# ---- 1) 发现 active PDP Context（cid + apn；来源 CGCONTRDP）----
	_ctxs=$(cgcontr_contexts "$SEC")
	CID=$(pick_context_cid "$CFG_APN" $_ctxs)

	# ---- 2) QCI（LTE 的 QoS Level）：AT+CGEQOSRDP=<cid> ----
	# 有明确 cid 就以 cid 定向查询；否则退回整表（head -n1 取第一条）。
	if [ -n "$CID" ]; then
		_QRAW=$(probe_at "$SEC" "AT+CGEQOSRDP=$CID")
	else
		_QRAW=$(probe_at "$SEC" 'AT+CGEQOSRDP')
	fi
	_Q=$(printf '%s' "$_QRAW" | sed -n 's/.*+CGEQOSRDP:[[:space:]]*//p' | head -n1)
	if [ -n "$_Q" ]; then
		# 规范字段：cid=1,QCI=2,DL_GBR=3,UL_GBR=4,DL_MBR=5,UL_MBR=6,DL_AMBR=7,UL_AMBR=8[,priority...]
		_qq=$(printf '%s\n' "$_Q" | awk -F',' '{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2}')
		if is_num "$_qq" && [ "$_qq" -ge 1 ] && [ "$_qq" -le 255 ]; then
			QCI="$_qq"; QCI_SRC="AT+CGEQOSRDP"; DOMAIN="LTE"
		fi
		_dl=$(printf '%s\n' "$_Q" | awk -F',' '{gsub(/^[ \t]+|[ \t]+$/,"",$7); print $7}')
		_ul=$(printf '%s\n' "$_Q" | awk -F',' '{gsub(/^[ \t]+|[ \t]+$/,"",$8); print $8}')
		_dl=$(norm_kbps "$_dl" CGEQOSRDP); _ul=$(norm_kbps "$_ul" CGEQOSRDP)
		if [ -z "$DL_KBPS" ] && [ -n "$_dl" ]; then DL_KBPS="$_dl"; RATE_SRC="AT+CGEQOSRDP"; fi
		if [ -z "$UL_KBPS" ] && [ -n "$_ul" ]; then UL_KBPS="$_ul"; [ -z "$RATE_SRC" ] && RATE_SRC="AT+CGEQOSRDP"; fi
	fi

	# ---- 3) 5QI（5G 的 QoS Level）：AT+C5GQOSRDP ----
	_N=$(probe_at "$SEC" 'AT+C5GQOSRDP' 2>/dev/null | sed -n 's/.*+C5GQOSRDP:[[:space:]]*//p' | head -n1)
	if [ -n "$_N" ]; then
		_q5=$(printf '%s\n' "$_N" | awk -F',' '{gsub(/^[ \t]+|[ \t]+$/,"",$2); print $2}')
		if is_num "$_q5" && [ "$_q5" -ge 1 ] && [ "$_q5" -le 255 ]; then
			FIVE_QI="$_q5"; FIVE_QI_SRC="AT+C5GQOSRDP"; [ "$DOMAIN" = "LTE" ] || DOMAIN="NR"
		fi
		# 8 字段形态：cid,5QI,GBR…,SAMBR(7),SAMBR(8)；若 7/8 非数值则退回最后两位
		_dl5=$(printf '%s\n' "$_N" | awk -F',' '{gsub(/^[ \t]+|[ \t]+$/,"",$7); print $7}')
		_ul5=$(printf '%s\n' "$_N" | awk -F',' '{gsub(/^[ \t]+|[ \t]+$/,"",$8); print $8}')
		is_num "$_dl5" || _dl5=$(printf '%s\n' "$_N" | awk -F',' '{print $(NF-1)}')
		is_num "$_ul5" || _ul5=$(printf '%s\n' "$_N" | awk -F',' '{print $NF}')
		_dl5=$(norm_kbps "$_dl5" C5GQOSRDP); _ul5=$(norm_kbps "$_ul5" C5GQOSRDP)
		if [ -z "$DL_KBPS" ] && [ -n "$_dl5" ]; then DL_KBPS="$_dl5"; RATE_SRC="AT+C5GQOSRDP"; fi
		if [ -z "$UL_KBPS" ] && [ -n "$_ul5" ]; then UL_KBPS="$_ul5"; [ -z "$RATE_SRC" ] && RATE_SRC="AT+C5GQOSRDP"; fi
	fi

	# ---- 4) APN + 兜底 AMBR：从选定上下文的 CGCONTRDP 取值 ----
	for _c in $_ctxs; do
		[ "$CID" = "$(field_of 1 "$_c")" ] || continue
		[ -n "$APN" ] || APN=$(field_of 2 "$_c")
		if [ -z "$DL_KBPS" ]; then
			_dl=$(norm_kbps "$(field_of 3 "$_c")" CGCONTRDP)
			[ -n "$_dl" ] && { DL_KBPS="$_dl"; [ -z "$RATE_SRC" ] && RATE_SRC="AT+CGCONTRDP"; }
		fi
		if [ -z "$UL_KBPS" ]; then
			_ul=$(norm_kbps "$(field_of 4 "$_c")" CGCONTRDP)
			[ -n "$_ul" ] && { UL_KBPS="$_ul"; [ -z "$RATE_SRC" ] && RATE_SRC="AT+CGCONTRDP"; }
		fi
		break
	done
	# 展示 APN：网络协商优先，退化为配置 APN
	[ -n "$APN" ] || APN="$CFG_APN"

	# ---- 5) 状态与输出 ----
	STATUS='no_data'
	if [ -n "$QCI" ] || [ -n "$FIVE_QI" ] || [ -n "$DL_KBPS" ] || [ -n "$UL_KBPS" ]; then
		STATUS='ok'
		if { [ -z "$QCI" ] && [ -z "$FIVE_QI" ]; } || { [ -z "$DL_KBPS" ] && [ -z "$UL_KBPS" ]; }; then
			STATUS='partial'
		fi
	fi

	qkv "status" "$(json_str "$STATUS")"
	qkv "qci" "$(json_num "$QCI")"
	qkv "qci_source" "$(json_str "$QCI_SRC")"
	qkv "five_qi" "$(json_num "$FIVE_QI")"
	qkv "five_qi_source" "$(json_str "$FIVE_QI_SRC")"
	qkv "downlink_rate_kbps" "$(json_num "$DL_KBPS")"
	qkv "uplink_rate_kbps" "$(json_num "$UL_KBPS")"
	qkv "rate_source" "$(json_str "$RATE_SRC")"
	qkv "apn" "$(json_str "$APN")"
	qkv "cid" "$(json_num "$CID")"
	qkv "domain" "$(json_str "$DOMAIN")"
	printf '{%s}\n' "$QKV"
}

# ---- radio_info -----------------------------------------------------------

do_radio_info() {
	SEC="$1"

	[ -n "$(qm_at_port "$SEC")" ] || { emit_unavailable_radio; return 0; }

	# ---- 1) GTCAINFO（Fibocom 系） ----
	PCC_LINE=$(probe_at "$SEC" 'AT+GTCAINFO?' | grep '^PCC:' | sed 's/^PCC://' | head -n1)
	if [ -n "$PCC_LINE" ]; then
		FOUND=$(printf '%s' "$PCC_LINE" | awk -F',' '
			function trim(s) { gsub(/[ \t]/, "", s); return s }
			{
				for (i = 1; i <= NF; i++) $i = trim($i);
				f1 = $1 + 0;
				rat = ""; band = "";
				if (f1 >= 101 && f1 <= 171) { rat = "LTE"; band = f1 - 100 }
				else if (f1 >= 501 && f1 <= 50512) {
					rat = "NR"; band = $1; sub(/^50/, "", band)
				} else next;
				if (rat == "LTE") {
					if (NF < 9) next;
					dm = $7; um = $8; dim = $5; uim = $6
				} else {
					if (NF >= 10) { dm = $8; um = $9; dim = $6; uim = $7 }
					else if (NF == 9) { dm = $7; um = $8; dim = $5; uim = $6 }
					else next
				}
				printf "RAT=%s\nBAND=%s\nDL_MIMO=%s\nUL_MIMO=%s\nDM=%s\nUM=%s\n", rat, band, dim, uim, dm, um
				exit
			}')
		if [ -n "$FOUND" ]; then
			eval "$FOUND"
			printf '{"rat":"%s"' "$RAT"
			[ -n "$BAND" ] && printf ',"band":"%s"' "$BAND"
			DM_TXT=$(mod_name "$DM")
			UM_TXT=$(mod_name "$UM")
			[ -n "$DM_TXT" ] && printf ',"dl_modulation":"%s"' "$DM_TXT"
			[ -n "$UM_TXT" ] && printf ',"ul_modulation":"%s"' "$UM_TXT"
			is_num "$DL_MIMO" && [ "$DL_MIMO" -ge 1 ] && printf ',"dl_mimo":%s' "$DL_MIMO"
			is_num "$UL_MIMO" && [ "$UL_MIMO" -ge 1 ] && printf ',"ul_mimo":%s' "$UL_MIMO"
			printf ',"status":"ok"}\n'
			return 0
		fi
	fi

	# ---- 2) Quectel 系：AT+QNWCFG="nr5g_csi" ----
	CSI_LINE=$(probe_at "$SEC" 'AT+QNWCFG="nr5g_csi"' | grep '+QNWCFG:' | head -n1)
	if [ -n "$CSI_LINE" ]; then
		DL_MCS=$(printf '%s\n' "$CSI_LINE" | awk -F',' '{gsub(/[ \t"]/, "", $1); v=$2+0; if ($2 != "" && v >= 0 && v <= 31) print v}')
		RAT_HINT="NR"
		printf '%s\n' "$CSI_LINE" | grep -q lte_csi && RAT_HINT="LTE"
		if [ -n "$DL_MCS" ]; then
			printf '{"rat":"%s","dl_mcs":%s,"status":"ok"}\n' "$RAT_HINT" "$DL_MCS"
			return 0
		fi
	fi

	emit_unavailable_radio
}

case "$1" in
	qos_info)   shift; do_qos_info "$@" ;;
	radio_info) shift; do_radio_info "$@" ;;
	*) echo "Usage: $0 {qos_info|radio_info} <config_section>" >&2; exit 1 ;;
esac
