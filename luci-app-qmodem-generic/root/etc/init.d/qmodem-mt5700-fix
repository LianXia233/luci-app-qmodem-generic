#!/bin/sh /etc/rc.common
# 每次开机检查并修复 MT5700 系列模组的 SIM 初始化命令。
# 通过 QModem 的 pre_dial_at_cmds 在拨号前注入 AT^SCICHG=0,1。
START=99
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/qmodem-mt5700-fix
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	# QModem 配置（模组识别）就绪或发生变化后，重新检查一次，
	# 以应对模组在更晚阶段才被识别、/etc/config/qmodem 才被写入的情况。
	procd_add_reload_trigger qmodem
}
