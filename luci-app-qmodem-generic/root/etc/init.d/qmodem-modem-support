#!/bin/sh /etc/rc.common
# 每次开机同步一次模组支持库：把本包内置的模组定义
# （如 rg520n-cn）合并进 QModem 的 /usr/share/qmodem/modem_support.json。
#
# START=90 早于 QModem 与 qmodem-mt5700-fix(99)，使本轮开机识别到新注入的
# 型号；脚本幂等，已存在时直接跳过，不产生额外开销。
#
# 真正的合并逻辑在 /usr/sbin/qmodem-modem-support。
#
# 为什么是经典（非 procd）脚本：这是一次性任务，跑完就退出。此前用
# USE_PROCD=1 且不带 respawn 参数，而 procd 的默认策略是「进程退出后最多
# 5 秒重试、1 小时内最多 5 次」，于是每次开机都会把合并脚本重跑 5 遍，
# syslog 里全是重复的「支持库已包含 …，跳过」。经典脚本只在 boot 时执行一次
# start()，语义与任务本身一致；日志仍由脚本自身的 logger 写入 syslog，
# 这里再放到后台，避免拖慢开机。
START=90
STOP=10

start() {
	# 与 rpcd 后端同理：随固件镜像落地时该脚本可能是 0644（源码未带可执行位
	# 且镜像打包不执行 postinst），直接执行会静默失败，导致开机自动同步从未
	# 生效。这里先补权限。
	if [ -f /usr/sbin/qmodem-modem-support ] && [ ! -x /usr/sbin/qmodem-modem-support ]; then
		chmod 755 /usr/sbin/qmodem-modem-support 2>/dev/null || true
	fi

	if [ -x /usr/sbin/qmodem-modem-support ]; then
		( /usr/sbin/qmodem-modem-support >/dev/null 2>&1 & ) 2>/dev/null
	else
		( sh /usr/sbin/qmodem-modem-support >/dev/null 2>&1 & ) 2>/dev/null
	fi

	return 0
}

stop() {
	return 0
}
