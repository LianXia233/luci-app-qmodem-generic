#!/bin/sh /etc/rc.common
# 每次开机同步一次模组支持库：把本包内置的模组定义
# （如 rg520n-cn）合并进 QModem 的 /usr/share/qmodem/modem_support.json。
#
# START=90 早于 QModem 与 qmodem-mt5700-fix(99)，使本轮开机识别到新注入的
# 型号；脚本幂等，已存在时直接跳过，不产生额外开销。
#
# 真正的合并逻辑在 /usr/sbin/qmodem-modem-support。
START=90
STOP=10
USE_PROCD=1

start_service() {
	# 与 rpcd 后端同理：随固件镜像落地时该脚本可能是 0644（源码未带可执行位
	# 且镜像打包不执行 postinst），procd 启动不可执行文件会静默失败，导致
	# 开机自动同步从未生效。这里先补权限再交给 procd。
	if [ -f /usr/sbin/qmodem-modem-support ] && [ ! -x /usr/sbin/qmodem-modem-support ]; then
		chmod 755 /usr/sbin/qmodem-modem-support 2>/dev/null || true
	fi

	procd_open_instance
	procd_set_param command /usr/sbin/qmodem-modem-support
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
