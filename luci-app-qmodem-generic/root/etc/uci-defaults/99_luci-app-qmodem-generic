#!/bin/sh
# 首次安装时立即为 MT5700 系列模组注入 SIM 初始化命令（无需重启即可生效），
# 并启用 /etc/init.d/qmodem-mt5700-fix，使其在每次开机时自动检查。
# 真正的修复逻辑位于 /usr/sbin/qmodem-mt5700-fix。

[ -x /usr/sbin/qmodem-mt5700-fix ] && /usr/sbin/qmodem-mt5700-fix
/etc/init.d/qmodem-mt5700-fix enable 2>/dev/null || true

# rpcd 插件必须可执行，否则 rpcd 不会加载（qos/签约速率面板将无数据）
[ -f /usr/libexec/rpcd/qos ] && chmod 755 /usr/libexec/rpcd/qos
[ -f /usr/libexec/rpcd/luci-app-qmodem-generic ] && chmod 755 /usr/libexec/rpcd/luci-app-qmodem-generic 2>/dev/null

exit 0
